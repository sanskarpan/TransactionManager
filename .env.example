# Environment variables for the Transaction Manager.
# Copy to .env and edit. Never commit .env.

# Bind address for the HTTP server. Default :8080.
LISTEN_ADDR=:8080

# If set, destructive endpoints (/api/reset, /api/mvcc/vacuum,
# /api/benchmark/run) require X-Admin-Token: <ADMIN_TOKEN>.
# Generate with: openssl rand -hex 32
# Empty (default) = open (local dev only — never in production).
ADMIN_TOKEN=

# Comma-separated allowed CORS origins. Empty (default) = "*" (dev).
# Production MUST set the frontend origin, e.g.
#   CORS_ALLOW_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOW_ORIGINS=

# slog level: DEBUG, INFO, WARN, ERROR. Default INFO.
LOG_LEVEL=INFO
